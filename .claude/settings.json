{
  "env": {
    "GRAPHIFY_SKIP_HOOK": "1"
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(/graphify-out/**)",
      "Edit(/graphify-out/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh secret set*)",
      "Bash(gh secret remove*)",
      "Bash(gh secret delete*)",
      "Bash(gh api *repos/*/actions/secrets*)",
      "Bash(gh issue create*)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "mcp__jarvis__vault_delete"
    ],
    "allow": [
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -c*)",
      "Bash(python3 enrich.py*)",
      "Bash(python enrich.py*)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv sync *)",
      "Bash(uv run python scripts/lint_claude_layer.py)",
      "Bash(python3 .claude/skills/finding-resources/scripts/check_vault_reachability.py)",
      "Bash(python3 .claude/skills/writing-internship-notes/scripts/lint_note.py *)",
      "Bash(uv run python .claude/skills/researching-companies/scripts/contact_signals.py *)",
      "Bash(git -C * check-ignore *)",
      "Agent(company-researcher)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify update *)",
      "mcp__jina__read_url",
      "mcp__jina__search_web",
      "mcp__jarvis__vault_read",
      "mcp__jarvis__vault_list",
      "mcp__jarvis__search_simple",
      "mcp__jarvis__search_query",
      "mcp__jarvis__vault_get_document_map",
      "mcp__jarvis__vault_write",
      "mcp__jarvis__vault_patch",
      "mcp__jarvis__vault_move",
      "mcp__jarvis-fs__read_file",
      "mcp__jarvis-fs__read_text_file",
      "mcp__jarvis-fs__read_multiple_files",
      "mcp__jarvis-fs__read_media_file",
      "mcp__jarvis-fs__write_file",
      "mcp__jarvis-fs__edit_file",
      "mcp__jarvis-fs__move_file",
      "mcp__jarvis-fs__create_directory",
      "mcp__jarvis-fs__list_directory",
      "mcp__jarvis-fs__list_directory_with_sizes",
      "mcp__jarvis-fs__directory_tree",
      "mcp__jarvis-fs__search_files",
      "mcp__jarvis-fs__get_file_info",
      "mcp__jarvis-fs__list_allowed_directories"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_guard.py"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_files.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.py"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
