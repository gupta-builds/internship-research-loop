#!/usr/bin/env bash
# Local safety gate for the two-laptop workflow. Human work reaches master
# through pull requests; GitHub Actions may still commit state/log updates
# directly because repository-level protection would block those jobs too.
#
# Sanity-checked 2026-08-22 against the graphify post-commit/post-checkout/
# post-merge hooks also installed in .git/hooks/ — different hook type
# (pre-push runs before the network push, graphify's hooks run after commit/
# checkout/merge), no conflict observed; commit+push still completes quickly
# with all four hooks present.
set -eu
cd "$(git rev-parse --show-toplevel)"

while read -r _local_ref _local_oid remote_ref _remote_oid; do
  if [ "$remote_ref" = "refs/heads/master" ] && [ "${ALLOW_MASTER_PUSH:-}" != "1" ]; then
    echo "pre-push: direct human pushes to master are blocked." >&2
    echo "Push a task branch and merge it through a PR. See docs/TWO_LAPTOP_WORKFLOW.md." >&2
    echo "Emergency-only override: ALLOW_MASTER_PUSH=1 git push ..." >&2
    exit 1
  fi
done

# Git exports GIT_DIR to hooks; in a linked worktree it is an absolute path to
# that worktree's gitdir, so tests that create throwaway repos (tests/test_git_ops.py)
# would act on the real repo. Observed 2026-11-21: core.bare=true and a junk commit.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

if [ -x .venv/bin/python ]; then
  .venv/bin/python -m pytest tests/ -q
elif command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
  uv run python -m pytest tests/ -q
else
  echo "pre-push: no test environment found; push blocked." >&2
  echo "Create .venv per README.md (or install uv when pyproject.toml is present)." >&2
  exit 1
fi
